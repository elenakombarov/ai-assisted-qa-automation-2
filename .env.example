# Placeholders only. Copy to .env and replace. Never commit real secrets.

# --- Run tests (required to clone and run Playwright) ---

# Didaxis Studio origin used as Playwright baseURL
DIDAXIS_URL=https://your-didaxis-host.example

# Admin email for auth.setup.ts storageState login
DIDAXIS_EMAIL=admin@example.com

# Admin password for auth.setup.ts storageState login
DIDAXIS_PASSWORD=your-didaxis-password

# Bearer token for API setup and program cleanup (not a UI login)
DIDAXIS_API_TOKEN=your-didaxis-api-token

# Optional second-account email for role or alternate-user tests
DIDAXIS_ALT_EMAIL=alt-user@example.com

# Optional second-account password for role or alternate-user tests
DIDAXIS_ALT_PASSWORD=your-didaxis-alt-password

# --- Agent / CI setup (not needed for npx playwright test alone) ---

# Cursor API key for the headless agent in .github/workflows/test-generation.yml
CURSOR_API_KEY=your-cursor-api-key

# Atlassian API token for Jira automation (MCP tokens stay in Cursor settings)
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Atlassian site origin (no trailing slash)
ATLASSIAN_BASE_URL=https://your-site.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN
ATLASSIAN_EMAIL=you@example.com
